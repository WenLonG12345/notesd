<?xml version="1.0" encoding="utf-8"?>
<!-- Instrument Sans is one variable font; each weight is an instance of it, so the editor's
     Typeface.create(family, weight) and bold spans pick real weights instead of synthesising them. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/instrument_sans"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 400"
        android:fontWeight="400" />
    <font
        android:font="@font/instrument_sans_italic"
        android:fontStyle="italic"
        android:fontVariationSettings="'wght' 400"
        android:fontWeight="400" />
    <font
        android:font="@font/instrument_sans"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 500"
        android:fontWeight="500" />
    <font
        android:font="@font/instrument_sans_italic"
        android:fontStyle="italic"
        android:fontVariationSettings="'wght' 500"
        android:fontWeight="500" />
    <font
        android:font="@font/instrument_sans"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 600"
        android:fontWeight="600" />
    <font
        android:font="@font/instrument_sans_italic"
        android:fontStyle="italic"
        android:fontVariationSettings="'wght' 600"
        android:fontWeight="600" />
    <font
        android:font="@font/instrument_sans"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 700"
        android:fontWeight="700" />
    <font
        android:font="@font/instrument_sans_italic"
        android:fontStyle="italic"
        android:fontVariationSettings="'wght' 700"
        android:fontWeight="700" />
</font-family>
