{
  "description": "Canonical app-produced Markdown (architecture §7.4). Every editor must parse each `markdown` and serialize it back byte for byte.",
  "cases": [
    { "name": "empty note", "markdown": "" },
    { "name": "paragraph", "markdown": "Hello world\n" },
    { "name": "paragraphs", "markdown": "First\n\nSecond\n" },
    { "name": "marks", "markdown": "**bold** *italic* ~~strike~~ ***both***\n" },
    { "name": "nested marks", "markdown": "**bold *and italic* text**\n" },
    { "name": "headings", "markdown": "# One\n\n## Two\n\n### Three\n" },
    { "name": "bullet list", "markdown": "- Milk\n- Bread\n" },
    { "name": "nested bullets", "markdown": "- Parent\n  - Child\n    - Grandchild\n" },
    { "name": "ordered list", "markdown": "1. First\n2. Second\n" },
    { "name": "ordered list from 3", "markdown": "3. Third\n4. Fourth\n" },
    { "name": "ordered list past 9", "markdown": "9. Nine\n10. Ten\n" },
    { "name": "task list", "markdown": "- [ ] Todo\n- [x] Done\n" },
    { "name": "nested tasks", "markdown": "- [ ] Parent\n  - [x] Child\n" },
    { "name": "mixed nesting", "markdown": "1. Step\n   - [ ] Check\n" },
    { "name": "adjacent bullet lists", "markdown": "- One\n\n* Two\n\n- Three\n" },
    { "name": "adjacent ordered lists", "markdown": "1. One\n\n1) Two\n" },
    { "name": "bullets then tasks", "markdown": "- Plain\n\n* [ ] Task\n" },
    { "name": "blockquote", "markdown": "> Quoted **text**\n" },
    { "name": "blockquote paragraphs", "markdown": "> One\n>\n> Two\n" },
    { "name": "list in quote", "markdown": "> - One\n> - Two\n" },
    { "name": "link", "markdown": "See [the docs](https://example.com/docs) now\n" },
    { "name": "link with title", "markdown": "[docs](https://example.com \"Docs\")\n" },
    { "name": "bold link", "markdown": "[**bold** link](https://x.y)\n" },
    { "name": "mailto", "markdown": "[Write](mailto:me@example.com)\n" },
    { "name": "hard break", "markdown": "line one\\\nline two\n" },
    { "name": "escaped emphasis", "markdown": "not \\*emphasis\\* here\n" },
    { "name": "escaped heading", "markdown": "\\# not a heading\n" },
    { "name": "unicode", "markdown": "**Café** 🎉 *naïve* 日本語\n" },
    { "name": "right to left", "markdown": "**שלום** עולם\n" },
    { "name": "raw: code span", "markdown": "Run `go **test**` now\n" },
    { "name": "raw: image", "markdown": "![a cat](cat.png)\n" },
    { "name": "raw: fenced code", "markdown": "Before\n\n```go\nfmt.Println(\"*hi*\")\n\n// done\n```\n\nAfter\n" },
    { "name": "raw: indented code", "markdown": "    indented code\n    second line\n" },
    { "name": "raw: table", "markdown": "| a | b |\n| - | - |\n| 1 | 2 |\n" },
    { "name": "raw: thematic break", "markdown": "Above\n\n---\n\nBelow\n" },
    { "name": "raw: fence in quote", "markdown": "> ```\n> *kept*\n> ```\n" }
  ]
}
