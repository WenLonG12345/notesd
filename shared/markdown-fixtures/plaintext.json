{
  "description": "Markdown → indexed plain text (architecture §8.1). Every platform's extractor must produce exactly `text` for `markdown`.",
  "cases": [
    { "name": "plain paragraph", "markdown": "Hello world", "text": "Hello world" },
    { "name": "bold", "markdown": "This is **important**.", "text": "This is important." },
    { "name": "italic star and underscore", "markdown": "*one* and _two_", "text": "one and two" },
    { "name": "bold italic", "markdown": "***both***", "text": "both" },
    { "name": "strikethrough", "markdown": "~~gone~~ here", "text": "gone here" },
    { "name": "single tilde is literal", "markdown": "about ~5 minutes", "text": "about ~5 minutes" },
    { "name": "snake_case is literal", "markdown": "call snake_case_name now", "text": "call snake_case_name now" },
    { "name": "spaced asterisk is literal", "markdown": "2 * 3 = 6", "text": "2 * 3 = 6" },
    { "name": "headings", "markdown": "# Title\n\n## Sub ##\n\n### Third", "text": "Title\n\nSub\n\nThird" },
    { "name": "hashtag is not a heading", "markdown": "#notes are tags", "text": "#notes are tags" },
    { "name": "bullet list", "markdown": "- Milk\n- Bread\n* Eggs\n+ Jam", "text": "Milk\nBread\nEggs\nJam" },
    { "name": "ordered list", "markdown": "1. First\n2) Second\n10. Tenth", "text": "First\nSecond\nTenth" },
    { "name": "nested list", "markdown": "- Parent\n  - Child\n    1. Grandchild", "text": "Parent\nChild\nGrandchild" },
    { "name": "task list", "markdown": "- [ ] Todo\n- [x] Done\n- [X] Also done", "text": "Todo\nDone\nAlso done" },
    { "name": "blockquote", "markdown": "> Quoted **text**\n> > nested", "text": "Quoted text\nnested" },
    { "name": "quoted list item", "markdown": "> - [ ] task in quote", "text": "task in quote" },
    { "name": "link", "markdown": "See [the docs](https://example.com/docs \"Docs\") now", "text": "See the docs now" },
    { "name": "link with emphasis", "markdown": "[**bold** link](https://x.y)", "text": "bold link" },
    { "name": "link with parens in url", "markdown": "[wiki](https://en.wikipedia.org/wiki/Go_(language))", "text": "wiki" },
    { "name": "image alt", "markdown": "![a cat](cat.png)", "text": "a cat" },
    { "name": "app image alt", "markdown": "![a cat](notesd:image/e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855?w=4&h=3)", "text": "a cat" },
    { "name": "app image without alt", "markdown": "Before\n\n![](notesd:image/e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855?w=4&h=3)\n\nAfter", "text": "Before\n\nAfter" },
    { "name": "brackets without link", "markdown": "[not a link] here", "text": "[not a link] here" },
    { "name": "autolink", "markdown": "Visit <https://example.com> today", "text": "Visit https://example.com today" },
    { "name": "less-than is literal", "markdown": "a < b and c > d", "text": "a < b and c > d" },
    { "name": "code span", "markdown": "Run `go **test**` now", "text": "Run go **test** now" },
    { "name": "fenced code", "markdown": "Before\n```go\nfmt.Println(\"*hi*\")\n```\nAfter", "text": "Before\nfmt.Println(\"*hi*\")\nAfter" },
    { "name": "escapes", "markdown": "not \\*emphasis\\* here", "text": "not *emphasis* here" },
    { "name": "thematic break", "markdown": "Above\n\n---\n\nBelow", "text": "Above\n\nBelow" },
    { "name": "blank lines collapse", "markdown": "\n\nA\n\n\n\nB\n\n", "text": "A\n\nB" },
    { "name": "hard line break", "markdown": "line one  \nline two", "text": "line one\nline two" },
    { "name": "crlf", "markdown": "a\r\nb", "text": "a\nb" },
    { "name": "unicode and emoji", "markdown": "**Café** 🎉 _naïve_ 日本語", "text": "Café 🎉 naïve 日本語" },
    { "name": "right to left", "markdown": "**שלום** עולם", "text": "שלום עולם" },
    { "name": "word boundaries across blocks", "markdown": "# end\nstart", "text": "end\nstart" }
  ]
}
